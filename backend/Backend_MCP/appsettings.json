{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ChatBotDb",
    "TaskItemsCollectionName": "task_items",
    "DepartmentsCollectionName": "departments",
    "UsersCollectionName": "users",
    "TaskChatMessagesCollectionName": "task_chat_messages"
  },
  "JsonRpcSettings": {
    "EndpointPath": "/api/mcp",
    "ServiceName": "task-management-api"
  },
  "JwtSettings": {
    "Issuer": "ChatBot",
    "Audience": "ChatBot",
    "SecretKey": "change-this-development-secret-key",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "Gemini": {
    "ApiKey": "Your API_KEY"
  },
  "AllowedHosts": "*"
}
